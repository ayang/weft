#!/bin/sh
# Weft postrm: refresh systemd state. On purge, drop the generated env file but
# keep the service account, database, uploads and backups: deleting the account
# would orphan those files and break a later reinstall.
set -e

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl reset-failed weft.service weft-scheduler.service \
    weft-backup.service weft-backup.timer >/dev/null 2>&1 || true
fi

if [ "$1" = purge ]; then
  if command -v deb-systemd-helper >/dev/null 2>&1; then
    deb-systemd-helper purge weft.service weft-scheduler.service >/dev/null 2>&1 || true
    deb-systemd-helper purge weft-backup.timer >/dev/null 2>&1 || true
  fi

  rm -f /etc/weft/weft.env /etc/weft/initial-admin.txt
  rmdir /etc/weft 2>/dev/null || true

  echo "Weft: kept the weft system user and /var/lib/weft (database and uploads)."
  echo "Weft: also kept /var/backups/weft. Remove them manually if you no longer"
  echo "Weft: need the data: deluser --system weft; rm -rf /var/lib/weft /var/backups/weft"
fi

exit 0
