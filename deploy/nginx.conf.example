# /etc/nginx/conf.d/weft.conf
#
# Replace weft.example.com with your domain. TLS certificates below are the
# certbot defaults; run `certbot --nginx -d weft.example.com` once first, or
# point ssl_certificate at your own files.

server {
    listen 80;
    listen [::]:80;
    server_name weft.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name weft.example.com;

    ssl_certificate     /etc/letsencrypt/live/weft.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/weft.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    # Media uploads are capped at 12 MB in the app; leave room for multipart
    # overhead. The app's own body limit is 16 MB.
    client_max_body_size 20m;

    # Security headers. HSTS only if you are sure about HTTPS-only.
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Optional: serve uploaded media straight from disk (skips the Rust
    # process). If you enable this, nginx must be able to traverse the media
    # directory:
    #   chmod 0711 /var/lib/weft
    #   chmod 0755 /var/lib/weft/media /var/lib/weft/media/uploads
    # Keep the alias in sync with MEDIA_DIR.
    # location /media/ {
    #     alias /var/lib/weft/media/uploads/;
    #     add_header Cache-Control "public, max-age=31536000, immutable";
    #     try_files $uri =404;
    # }

    location / {
        proxy_pass http://127.0.0.1:5150;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # AI article edits run synchronously and can take up to ~60s.
        proxy_connect_timeout 10s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;
    }
}
