# /etc/weft/weft.env — Weft production environment
#
# Read by both systemd units via EnvironmentFile=. Keep it root-owned,
# group-readable by the service user (mode 0640):
#   install -m 0640 -o root -g weft deploy/weft.env.example /etc/weft/weft.env
#
# Values with spaces must be quoted. Do not commit the filled-in file.

# --- Runtime ---------------------------------------------------------------
# Runtime resources (themes/, assets/) are resolved from this working directory.
# The systemd units set it for you; export it when running weft-cli by hand.
# WEFT_APP_DIR=/srv/weft
LOCO_ENV=production
# Config directory containing production.yaml (and scheduler.yaml).
LOCO_CONFIG_FOLDER=/etc/weft
PORT=5150
# Behind nginx: bind loopback only. Use 0.0.0.0 only if nginx is on another host.
BINDING=127.0.0.1
LOG_LEVEL=info

# --- Data ------------------------------------------------------------------
# Absolute paths are required in production. /var/lib/weft is created by the
# systemd unit (StateDirectory=weft).
DATABASE_URL=sqlite:///var/lib/weft/weft.sqlite?mode=rwc
MEDIA_DIR=/var/lib/weft/media/uploads
DB_MAX_CONNECTIONS=5
# Run `weft-cli db migrate` explicitly during a release instead of racing at boot.
DB_AUTO_MIGRATE=false

# --- Secrets (generate your own) -------------------------------------------
# openssl rand -base64 48
JWT_SECRET=CHANGE_ME
# openssl rand -hex 32
# Legacy read-only token. For write access create a scoped key in
# /admin/settings/api-keys (or weft-cli task agent:key-create).
AGENT_API_TOKEN=

# --- Site ------------------------------------------------------------------
# The only account allowed to sign in at /admin. Change this before creating
# the admin user: the login email must match this value.
ADMIN_EMAIL=admin@example.com
# Final public URL (TLS terminated by nginx), used for sitemap/llms.txt/API links.
SITE_BASE_URL=https://weft.example.com
SITE_TITLE=Weft
SITE_BRAND=
SITE_TAGLINE="人与 AI 的编织现场"
SITE_DESCRIPTION="一个人与 AI 协作生产内容的动态个人站点"
SITE_AUTHOR=Weft
# Theme directory name under the app directory (deb: /usr/share/weft/themes,
# source install: /srv/weft/themes). Changing it needs a restart.
SITE_THEME=default

# --- AI (optional) ---------------------------------------------------------
# Leave AI_PROVIDER=offline to run without any external model calls.
AI_PROVIDER=offline
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_DAILY_COST_LIMIT_USD=1.0
