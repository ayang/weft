# Copy to .env.local (git-ignored) and load from your process manager.
LOCO_ENV=development
PORT=5150
BINDING=127.0.0.1
DATABASE_URL=sqlite://weft_development.sqlite?mode=rwc
JWT_SECRET=replace-with-at-least-32-random-bytes
ADMIN_EMAIL=admin@example.com
SITE_BASE_URL=http://localhost:5150
SITE_THEME=default
SITE_TITLE=Weft
SITE_BRAND=Weft
SITE_TAGLINE=人与 AI 的编织现场
SITE_DESCRIPTION=一个人与 AI 协作生产内容的动态个人站点
SITE_AUTHOR=Weft

# Empty api key means offline extractive mode (no external calls).
OPENAI_API_KEY=
AI_PROVIDER=offline
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_DAILY_COST_LIMIT_USD=1.0
AI_ARTICLE_MAX_OUTPUT_TOKENS=4000

# Agent API is public when empty; set a long random token in production.
AGENT_API_TOKEN=
AGENT_RATE_LIMIT_PER_MIN=30

DB_MAX_CONNECTIONS=4
LOG_LEVEL=debug

# AI is admin/worker only. There is no public ask endpoint.
